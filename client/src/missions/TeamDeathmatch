export class TeamDeathmatch {
  constructor(options = {}) {
    this.id = "team_deathmatch";
    this.mode = "TEAM DEATHMATCH";

    this.player = options.player || null;
    this.spawner = options.spawner || null;

    this.started = false;
    this.completed = false;
    this.failed = false;

    this.playerScore = 0;
    this.enemyScore = 0;

    this.targetScore =
      options.targetScore || 25;

    this.timeLimit =
      options.timeLimit || 600;

    this.elapsedTime = 0;

    this.maxEnemies =
      options.maxEnemies || 8;

    this.objectives = [
      {
        id: "score",
        title: "Reach the target score",
        description:
          "Eliminate enemy combatants and reach the target score.",
        progress: 0,
        target: this.targetScore
      },

      {
        id: "survive",
        title: "Stay in the fight",
        description:
          "Keep fighting until the match is decided.",
        progress: 0,
        target: this.timeLimit
      }
    ];
  }

  start() {
    this.started = true;
    this.completed = false;
    this.failed = false;

    this.playerScore = 0;
    this.enemyScore = 0;

    this.elapsedTime = 0;

    this.resetObjectives();

    if (
      this.spawner &&
      typeof this.spawner.reset ===
        "function"
    ) {
      this.spawner.reset();
    }

    if (
      this.spawner &&
      typeof this.spawner.setEnabled ===
        "function"
    ) {
      this.spawner.setEnabled(true);
    }
  }

  update(dt) {
    if (
      !this.started ||
      this.completed ||
      this.failed
    ) {
      return;
    }

    if (!Number.isFinite(dt)) {
      return;
    }

    this.elapsedTime += dt;

    this.updateObjectives();

    this.checkPlayer();

    if (
      this.playerScore >=
      this.targetScore
    ) {
      this.complete(
        "score"
      );

      return;
    }

    if (
      this.enemyScore >=
      this.targetScore
    ) {
      this.fail(
        "The enemy team reached the target score."
      );

      return;
    }

    if (
      this.elapsedTime >=
      this.timeLimit
    ) {
      this.resolveTimeLimit();
    }
  }

  addPlayerKill() {
    if (!this.started) {
      return;
    }

    this.playerScore++;

    this.setObjectiveProgress(
      "score",
      this.playerScore
    );

    if (
      this.playerScore >=
      this.targetScore
    ) {
      this.complete(
        "score"
      );
    }
  }

  addEnemyKill() {
    if (!this.started) {
      return;
    }

    this.enemyScore++;

    if (
      this.enemyScore >=
      this.targetScore
    ) {
      this.fail(
        "The enemy team reached the target score."
      );
    }
  }

  checkPlayer() {
    if (!this.player) {
      return;
    }

    if (
      typeof this.player.isDead ===
      "function"
    ) {
      if (
        this.player.isDead()
      ) {
        // Death does not immediately
        // end the match.
        //
        // The player can respawn and
        // continue fighting.
      }
    }
  }

  updateObjectives() {
    this.setObjectiveProgress(
      "score",
      Math.min(
        this.targetScore,
        this.playerScore
      )
    );

    this.setObjectiveProgress(
      "survive",
      Math.min(
        this.timeLimit,
        this.elapsedTime
      )
    );
  }

  resolveTimeLimit() {
    if (
      this.playerScore >
      this.enemyScore
    ) {
      this.complete(
        "time"
      );

      return;
    }

    if (
      this.enemyScore >
      this.playerScore
    ) {
      this.fail(
        "The enemy team had the higher score."
      );

      return;
    }

    // Draw:
    // extend the match for a short
    // overtime period.
    this.timeLimit += 60;
  }

  complete(reason = "complete") {
    if (
      this.completed ||
      this.failed
    ) {
      return;
    }

    this.completed = true;
    this.started = false;

    this.completionReason =
      reason;

    if (
      this.spawner &&
      typeof this.spawner.setEnabled ===
        "function"
    ) {
      this.spawner.setEnabled(false);
    }
  }

  fail(
    reason = "Mission failed"
  ) {
    if (
      this.completed ||
      this.failed
    ) {
      return;
    }

    this.failed = true;
    this.started = false;

    this.failReason =
      reason;

    if (
      this.spawner &&
      typeof this.spawner.setEnabled ===
        "function"
    ) {
      this.spawner.setEnabled(false);
    }
  }

  setObjectiveProgress(
    id,
    progress
  ) {
    const objective =
      this.objectives.find(
        (item) =>
          item.id === id
      );

    if (!objective) {
      return;
    }

    objective.progress =
      Math.max(
        0,
        Math.min(
          objective.target,
          progress
        )
      );
  }

  resetObjectives() {
    for (
      const objective of
      this.objectives
    ) {
      objective.progress = 0;
    }
  }

  getRemainingTime() {
    return Math.max(
      0,
      this.timeLimit -
        this.elapsedTime
    );
  }

  getActiveObjective() {
    return (
      this.objectives.find(
        (objective) =>
          objective.progress <
          objective.target
      ) || null
    );
  }

  getState() {
    return {
      id: this.id,
      mode: this.mode,

      started: this.started,
      completed: this.completed,
      failed: this.failed,

      playerScore:
        this.playerScore,

      enemyScore:
        this.enemyScore,

      targetScore:
        this.targetScore,

      elapsedTime:
        this.elapsedTime,

      timeLimit:
        this.timeLimit,

      remainingTime:
        this.getRemainingTime(),

      objectives:
        this.objectives.map(
          (objective) => ({
            ...objective
          })
        ),

      activeObjective:
        this.getActiveObjective(),

      completionReason:
        this.completionReason ||
        null,

      failReason:
        this.failReason ||
        null
    };
  }

  destroy() {
    this.player = null;
    this.spawner = null;

    this.objectives = [];
  }
}
